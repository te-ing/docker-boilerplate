
SERVER_API_PORT=3000
NGINX_EXPOSE_PORT=80
NGINX_EXPOSE_PORT=443
LOCAL_KEY_LOCATION=./nginx/key.pem
LOCAL_CERT_LOCATION=./nginx/cert.pem
NGINX_KEY_LOCATION=/etc/nginx/key.pem
NGINX_CERT_LOCATION=/etc/nginx/cert.pem
SERVER_KEY_LOCATION=/app/secrets/key.pem
SERVER_CERT_LOCATION=/app/secrets/cert.pem


# Config for Common
LC_ALL=C.UTF-8
LANG=C.UTF-8
TZ=Asia/Seoul

# Config for MySQL
RSA_PRIVATE_KEY
# Config for MySQL
MYSQL_SERVER_PORT=3306
MYSQL_SERVER_HOST=mysql
MYSQL_ROOT_PASSWORD=1234!
MYSQL_USER=test_user
MYSQL_PASSWORD=root
MYSQL_DATABASE=test_db

# Config for Security
JWT_SECRET=test_super_secret
