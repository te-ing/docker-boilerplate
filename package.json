{
  "name": "docker-node-app",
  "version": "1.0.0",
  "description": "A simple Node.js app in Docker",
  "type": "module",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "DOTENV_CONFIG_PATH=.env-local node -r dotenv/config app.js"
  },
  "dependencies": {
    "express": "^4.19.2"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "devDependencies": {
    "dotenv": "^16.4.5"
  }
}
